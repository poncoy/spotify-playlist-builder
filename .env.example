# Copiá este archivo a .env y completá con tus credenciales de
# https://developer.spotify.com/dashboard (Create app)
SPOTIFY_CLIENT_ID=tu_client_id
SPOTIFY_CLIENT_SECRET=tu_client_secret

# Opcional: fecha (AAAA-MM-DD) en la que generaste/rotaste el Client Secret.
# Si la completás, la app avisa en cada corrida cuando falten <=15, <=7 o <=3
# días para el próximo vencimiento (SPOTIFY_SECRET_ROTATED_AT + ROTATION_DAYS).
# SPOTIFY_SECRET_ROTATED_AT=2026-09-16
# SPOTIFY_SECRET_ROTATION_DAYS=90

# Opcional: ruta al archivo de setlist (por defecto: canciones.txt)
# CANCIONES_FILE=canciones.txt

# Opcional: API key de https://getsongbpm.com/api (registro gratis con backlink).
# Se usa como fallback de BPM/Tonalidad cuando el audio-features de Spotify
# devuelve 403 (apps sin Extended Quota Mode).
# GETSONGBPM_API_KEY=tu_api_key

# Opcional: GetSongBPM no documenta que sus keys expiren, pero por buena
# práctica podés pedir el mismo tipo de aviso (<=15/7/3 días) que con el
# Client Secret de Spotify, con tu propio plazo de revisión.
# GETSONGBPM_KEY_ROTATED_AT=2026-09-17
# GETSONGBPM_KEY_ROTATION_DAYS=90
